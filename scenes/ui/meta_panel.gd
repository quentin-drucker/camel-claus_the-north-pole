extends PanelContainer
## Main-menu pages built in code, one script for four pages (set `page`), all a PlateTight panel with a
## header band and close X (style guide 5.6):
## - WORKSHOP: permanent upgrades (level, effect now > next, price) and weapons to buy once their
##   achievement is earned. Coins in the header.
## - ACHIEVEMENTS: the postcard. Header shows earned / total, a progress bar and coins earned; category
##   tabs (All, Survival, Bonks, Santa, Collection) with their own progress; rows with the goal's stamp
##   (postmarked when earned), progress and reward or "Delivered".
## - STATS: personal bests and lifetime totals as two label/value tables.
## - CREDITS: who and what made the game.
## Rebuilt every time it opens, so it always shows the saved Profile.

signal closed

enum Page { WORKSHOP, ACHIEVEMENTS, STATS, CREDITS }

const ROW_ICON: int = 56
const TITLES: Array[String] = ["Workshop", "Achievements", "Stats", "Credits"]
## Achievement tabs: [category key ("" = all), name].
const TABS: Array[Array] = [["", "All"], ["survival", "Survival"], ["bonks", "Bonks"], ["santa", "Santa"],
	["collection", "Collection"]]
const TICK: Texture2D = preload("res://assets/ui/tin/icon_tick.png")
const POST_RED: Color = Color("C42F3A")
## Credits page: [heading, lines].
const CREDITS: Array[Array] = [
	["Made with", "Godot 4.7 (engine) and Blender (3D modelling)"],
	["Art, music and code", "3D models, pixel textures, UI art, music and jingles made with Claude Opus 5.5\n(Anthropic), modelled and baked in Blender, generated by the project's own tools"],
	["Sound effects", "Kenney.nl - Interface Sounds and Digital Audio packs (CC0)"],
	["Music", "An original chiptune arrangement of \"Jingle Bells\" (J. L. Pierpont, 1857, public domain)"],
	["Fonts", "New Rocker by Pablo Impallari, Tiny5 by Gissio, Bowlby One by Vernon Adams\n(SIL Open Font License 1.1)"],
]

@export var page: Page = Page.WORKSHOP

var _header_extra: HBoxContainer
var _tab_row: HBoxContainer
var _tab: int = 0
var _list: VBoxContainer
var _scroll: ScrollContainer
var _back: Button


func _ready() -> void:
	theme_type_variation = &"PlateTight"
	var column := VBoxContainer.new()
	column.add_theme_constant_override(&"separation", 0)
	add_child(column)
	_header_extra = HBoxContainer.new()
	_header_extra.add_theme_constant_override(&"separation", 14)
	column.add_child(Tin.header(TITLES[page], _header_extra, close))
	_scroll = ScrollContainer.new()
	_scroll.custom_minimum_size = Vector2(1040, 430)
	_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	_list = VBoxContainer.new()
	_list.add_theme_constant_override(&"separation", 8)
	_list.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var pad := MarginContainer.new()  # room for the scrollbar on the right
	pad.add_theme_constant_override(&"margin_right", 16)
	pad.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	pad.add_child(_list)
	_scroll.add_child(pad)
	if page == Page.ACHIEVEMENTS:
		_tab_row = HBoxContainer.new()
		_tab_row.add_theme_constant_override(&"separation", 6)
		var tabs_pad := Tin.body(_tab_row, 14)
		tabs_pad.add_theme_constant_override(&"margin_bottom", 4)
		column.add_child(tabs_pad)
		var card := PanelContainer.new()  # the list is a postcard: paper inside an airmail border
		card.theme_type_variation = &"AirmailPanel"
		var inner := VBoxContainer.new()
		inner.add_theme_constant_override(&"separation", 6)
		card.add_child(inner)
		var label := Tin.label("Camel Post  -  North Pole 90°N", &"InkSmall")
		label.add_theme_color_override(&"font_color", POST_RED)
		inner.add_child(label)
		inner.add_child(_scroll)
		_scroll.custom_minimum_size = Vector2(1010, 420)
		column.add_child(Tin.body(card, 14))
	else:
		column.add_child(Tin.body(_scroll, 18))
		_back = Button.new()
		_back.text = "Back"
		_back.theme_type_variation = &"PrimaryButton"
		_back.custom_minimum_size = Vector2(150, 0)
		_back.size_flags_horizontal = Control.SIZE_SHRINK_END
		_back.pressed.connect(close)
		_back.mouse_entered.connect(_back.grab_focus)
		column.add_child(Tin.body(_back, 18))
	visibility_changed.connect(func() -> void:
		if visible:
			_tab = 0
			refresh()
			if _back:
				_back.grab_focus()
			elif _tab_row.get_child_count() > 0:
				(_tab_row.get_child(0) as Button).grab_focus())


func _unhandled_input(event: InputEvent) -> void:
	if visible and event.is_action_pressed("ui_cancel"):
		close()
		get_viewport().set_input_as_handled()


func close() -> void:
	Audio.play(&"click")
	hide()
	closed.emit()


func refresh() -> void:
	for box: Control in [_list, _header_extra]:
		for child in box.get_children():
			box.remove_child(child)
			child.queue_free()
	match page:
		Page.WORKSHOP:
			_header_extra.add_child(Tin.coin(Tin.num(Profile.coins()), &"HudLabel", 28))
			_fill_workshop()
		Page.ACHIEVEMENTS:
			_fill_achievements()
		Page.STATS:
			_fill_stats()
		Page.CREDITS:
			_fill_credits()


func _fill_workshop() -> void:
	for item in Profile.WORKSHOP:
		var level: int = Profile.workshop_level(item)
		var cost: int = Profile.workshop_cost(item)
		var now: String = item.describe(level) if level > 0 else "nothing yet"
		var text: String = "[b]%s[/b]  %s\n%s" % [item.title, Describe.c(Describe.MUTED, "Lv %d/%d" % [level, item.max_level()]),
			("Now %s" % now) + (("  →  " + Describe.c(Describe.GOOD, item.describe(level + 1))) if cost >= 0 else "")]
		var buy: Button = _row(Describe.icon(item.icon), text, "MAX" if cost < 0 else "Buy  %d" % cost)
		buy.disabled = cost < 0 or Profile.coins() < cost
		if cost >= 0:
			buy.icon = Tin.COIN
		buy.pressed.connect(func() -> void:
			if Profile.buy_workshop(item):
				Audio.play(&"chest")
				refresh())
	for card in Profile.WEAPON_CARDS:
		var id: String = Profile.weapon_id(card)
		if Profile.is_unlocked(id) or Profile.unlock_goal(id) == null:
			continue
		var price: int = Profile.WEAPON_PRICES.get(id, 0)
		var buyable: bool = Profile.is_buyable(id)
		var text: String = "[b]%s[/b]  %s\n%s" % [card.title, Describe.c(Describe.ICE, "New weapon"),
			Describe.c(Describe.GOOD if buyable else Describe.MUTED, Profile.unlock_hint(id))]
		var buy: Button = _row(Describe.icon_for(card) if buyable else Describe.icon("lock"), text,
			"Buy  %d" % price if buyable else "Locked")
		buy.disabled = not buyable or Profile.coins() < price
		if buyable:
			buy.icon = Tin.COIN
		buy.pressed.connect(func() -> void:
			if Profile.buy_weapon(id):
				Audio.play(&"evolve")
				refresh())


## Run-only stats reset after a run, so an earned goal shows its target, not today's count.
func _have(goal: AchievementData, p: Dictionary) -> float:
	return goal.target if Profile.has_achievement(goal.id) else minf(p.get(goal.stat, 0.0), goal.target)


func _fill_achievements() -> void:
	var all: Array[AchievementData] = Profile.ACHIEVEMENTS
	var done: int = 0
	var earned_coins: int = 0
	for goal in all:
		if Profile.has_achievement(goal.id):
			done += 1
			earned_coins += goal.reward_coins
	# Header: "6 / 18", total bar, coins earned.
	var count := Tin.label("%d / %d" % [done, all.size()], &"GoalTitle")
	_header_extra.add_child(count)
	var total := Tin.bar(&"TabProgress", done, all.size(), 10)
	total.custom_minimum_size = Vector2(150, 10)
	total.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	_header_extra.add_child(total)
	var gap := Control.new()
	gap.custom_minimum_size = Vector2(300, 0)
	_header_extra.add_child(gap)
	_header_extra.add_child(Tin.coin("+%s earned" % Tin.num(earned_coins), &"Label"))
	_fill_tabs()
	# Rows: this tab's goals, earned first (Megabonk's quest list).
	var p: Dictionary = Profile.progress()
	var goals: Array[AchievementData] = all.filter(func(g: AchievementData) -> bool:
		return TABS[_tab][0] == "" or g.category == TABS[_tab][0])
	goals.sort_custom(func(a: AchievementData, b: AchievementData) -> bool:
		return Profile.has_achievement(a.id) and not Profile.has_achievement(b.id))
	for goal in goals:
		_achievement_row(goal, _have(goal, p))
	_scroll.scroll_vertical = 0


func _fill_tabs() -> void:
	for child in _tab_row.get_children():
		_tab_row.remove_child(child)
		child.queue_free()
	for i in TABS.size():
		var key: String = TABS[i][0]
		var n: int = 0
		var d: int = 0
		for goal in Profile.ACHIEVEMENTS:
			if key == "" or goal.category == key:
				n += 1
				d += int(Profile.has_achievement(goal.id))
		var tab := Button.new()
		tab.theme_type_variation = &"TabButton"
		tab.toggle_mode = true
		tab.set_pressed_no_signal(i == _tab)
		tab.custom_minimum_size = Vector2(150, 66)
		tab.set_meta(&"no_brackets", true)
		var box := VBoxContainer.new()
		box.add_theme_constant_override(&"separation", 2)
		box.mouse_filter = Control.MOUSE_FILTER_IGNORE
		box.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		box.offset_left = 14
		box.offset_right = -14
		box.offset_top = 6
		box.offset_bottom = -6
		tab.add_child(box)
		box.add_child(Tin.label(TABS[i][1], &"NameLabel" if i == _tab else &"TabName"))
		box.add_child(Tin.label("%d / %d" % [d, n], &"SmallLabel"))
		var bar := Tin.bar(&"TabProgress", d, n, 7)
		bar.size_flags_vertical = Control.SIZE_SHRINK_END
		box.add_child(bar)
		tab.pressed.connect(func() -> void:
			Audio.play(&"click")
			_tab = i
			refresh()
			(_tab_row.get_child(i) as Button).grab_focus())
		tab.mouse_entered.connect(tab.grab_focus)
		_tab_row.add_child(tab)


## One postcard row: stamp (postmarked when earned), title + description in ink, progress, then the
## coin reward or "Delivered" with a tick.
func _achievement_row(goal: AchievementData, have: float) -> void:
	var earned: bool = Profile.has_achievement(goal.id)
	var row := HBoxContainer.new()
	row.add_theme_constant_override(&"separation", 16)
	row.custom_minimum_size = Vector2(0, 70)
	_list.add_child(row)
	var stamp := Tin.stamp(Describe.goal_icon(goal), "evo" if earned else "common", 38, earned)
	stamp.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(stamp)
	var text := VBoxContainer.new()
	text.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	text.alignment = BoxContainer.ALIGNMENT_CENTER
	text.add_theme_constant_override(&"separation", 0)
	row.add_child(text)
	text.add_child(Tin.label(goal.title, &"InkTitle"))
	var sub: String = goal.description
	if goal.unlocks_weapon:
		sub += "  -  unlocks " + Profile.weapon_card(goal.unlocks_weapon).title
	text.add_child(Tin.label(sub, &"InkSmall"))
	var meter := VBoxContainer.new()
	meter.custom_minimum_size = Vector2(200, 0)
	meter.alignment = BoxContainer.ALIGNMENT_CENTER
	row.add_child(meter)
	var count := Tin.label("%s / %s" % [_goal_num(goal, have), _goal_num(goal, goal.target)], &"InkLabel")
	count.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	meter.add_child(count)
	meter.add_child(Tin.bar(&"GoodBar", have, goal.target, 10))
	var reward := HBoxContainer.new()
	reward.custom_minimum_size = Vector2(160, 0)
	reward.alignment = BoxContainer.ALIGNMENT_END
	reward.add_theme_constant_override(&"separation", 8)
	reward.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(reward)
	if earned:
		var delivered := Tin.label("Delivered", &"InkTitle")
		delivered.add_theme_color_override(&"font_color", Color("3A8FBF"))
		delivered.rotation_degrees = -6.0
		reward.add_child(delivered)
		var tick := TextureRect.new()
		tick.texture = TICK
		tick.stretch_mode = TextureRect.STRETCH_KEEP_CENTERED
		tick.mouse_filter = Control.MOUSE_FILTER_IGNORE
		reward.add_child(tick)
	else:
		reward.add_child(Tin.coin(str(goal.reward_coins), &"InkLabel", 22))
	var rule := ColorRect.new()  # the postcard's ruled line
	rule.color = Color(0.133, 0.188, 0.31, 0.2)
	rule.custom_minimum_size = Vector2(0, 2)
	rule.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_list.add_child(rule)


static func _goal_num(goal: AchievementData, v: float) -> String:
	if goal.stat.ends_with("seconds"):
		return _clock(v)
	return Tin.num(int(v))


func _fill_stats() -> void:
	var row := HBoxContainer.new()
	row.add_theme_constant_override(&"separation", 40)
	_list.add_child(row)
	var bests: Dictionary = Profile.data["bests"]
	var best_rows: Array[Array] = []
	for key: String in Profile.BEST_LABELS:
		var v: float = float(bests.get(key, 0.0))
		best_rows.append([Profile.BEST_LABELS[key], _clock(v) if key in ["time", "endless"] else Tin.num(int(v))])
	var left := _stat_table("Personal bests", best_rows)
	if bests.has("build"):
		left.add_child(Tin.label("Best run's build", &"SubLabel"))
		left.add_child(Tin.label(", ".join(PackedStringArray(bests["build"])), &"MutedLabel", true))
	row.add_child(left)
	var all_rows: Array[Array] = []
	for key: String in Profile.STAT_LABELS:
		var v: float = Profile.stat(key)
		all_rows.append([Profile.STAT_LABELS[key], _clock(v) if key == "time" else Tin.num(int(v))])
	row.add_child(_stat_table("All runs", all_rows))


## A titled label/value table (labels left in tan, values right in white), like the pause Stats panel.
func _stat_table(title: String, rows: Array[Array]) -> VBoxContainer:
	var box := VBoxContainer.new()
	box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	box.add_theme_constant_override(&"separation", 8)
	box.add_child(Tin.label(title, &"SubLabel"))
	var grid := GridContainer.new()
	grid.columns = 2
	grid.add_theme_constant_override(&"v_separation", 6)
	box.add_child(grid)
	for r in rows:
		var k := Tin.label(r[0], &"StatLabel")
		k.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		grid.add_child(k)
		var v := Tin.label(r[1])
		v.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		grid.add_child(v)
	return box


func _fill_credits() -> void:
	_scroll.custom_minimum_size = Vector2(900, 420)
	for entry: Array in CREDITS:
		var box := VBoxContainer.new()
		box.add_theme_constant_override(&"separation", 4)
		box.add_child(Tin.label(entry[0], &"SubLabel"))
		box.add_child(Tin.label(entry[1], &"", true))
		_list.add_child(box)
	_list.add_theme_constant_override(&"separation", 18)


## One Workshop row: icon tile, two lines of BBCode text, and a buy button.
func _row(icon: Texture2D, text: String, button_text: String) -> Button:
	var card := PanelContainer.new()  # knit row card (style guide 4.1/4.4)
	card.theme_type_variation = &"KnitCard"
	_list.add_child(card)
	var row := HBoxContainer.new()
	row.add_theme_constant_override(&"separation", 12)
	card.add_child(row)
	var picture := Tin.tile(icon, "common", ROW_ICON - 12)
	picture.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(picture)
	var label := RichTextLabel.new()
	label.bbcode_enabled = true
	label.fit_content = true
	label.scroll_active = false
	label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	label.text = text
	row.add_child(label)
	var button := Button.new()
	button.text = button_text
	button.theme_type_variation = &"SmallButton"
	button.custom_minimum_size = Vector2(170, 0)
	button.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	button.mouse_entered.connect(button.grab_focus)
	row.add_child(button)
	return button


static func _clock(seconds: float) -> String:
	var s: int = int(seconds)
	if s >= 3600:
		@warning_ignore("integer_division")
		return "%dh %02dm" % [s / 3600, (s % 3600) / 60]
	@warning_ignore("integer_division")
	return "%d:%02d" % [s / 60, s % 60]
